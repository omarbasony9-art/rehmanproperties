# ============================================================
# REHMAN INC — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ============================================================

# Admin Dashboard Password
# Set a strong password — this is the only protection on /admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Cookie signing secret (random string, at least 32 chars)
COOKIE_SECRET=generate-a-random-32-char-secret-here

# ============================================================
# EMAIL (Resend)
# ============================================================
# Sign up at https://resend.com — free tier sends 3,000 emails/month
# Verify your sending domain in the Resend dashboard
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
INQUIRY_NOTIFICATION_EMAIL=your@email.com

# ============================================================
# CLOUDFLARE R2 (Photo Uploads)
# ============================================================
# Required for property photo uploads in production.
# Create a bucket at https://dash.cloudflare.com → R2
# Create an API token with R2 read/write permissions
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=rehman-inc-photos

# Public URL for R2 bucket (configure in R2 → Settings → Custom Domain or use r2.dev)
# Example: https://photos.rehmaninc.com or https://pub-xxxx.r2.dev
R2_PUBLIC_URL=https://photos.rehmaninc.com

# ============================================================
# TRACKING / ANALYTICS (all optional — site works without these)
# ============================================================
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Google Ads Conversion ID (e.g. AW-XXXXXXXXXX)
VITE_GOOGLE_ADS_CONVERSION_ID=

# Meta (Facebook) Pixel ID
VITE_META_PIXEL_ID=

# Cloudflare Turnstile Site Key (for bot protection on the form)
# Create at https://dash.cloudflare.com → Turnstile
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=

# ============================================================
# CONTACT INFORMATION PLACEHOLDERS
# Replace with real info before going live
# ============================================================
VITE_CONTACT_PHONE=(000) 000-0000
VITE_CONTACT_EMAIL=info@rehmaninc.com
VITE_CONTACT_ADDRESS=

# ============================================================
# LOCAL DEVELOPMENT (not needed for Cloudflare D1 in production)
# ============================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rehman_inc
